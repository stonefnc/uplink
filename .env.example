# Copy this file to .env and edit the values. Never commit .env.

# --- LLM endpoint -----------------------------------------------------------
# Any endpoint that speaks the chat completions API. Base URL should end in /v1.
# When n8n runs in Docker and the endpoint runs on the host machine, use
# host.docker.internal in the URL instead of localhost.
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-model-name

# --- n8n --------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Public URL that webhook callers use to reach n8n.
N8N_WEBHOOK_URL=http://localhost:5678/

# Time zone for schedules and timestamps.
GENERIC_TIMEZONE=UTC
TZ=UTC

# Generate a long random string, for example: openssl rand -hex 32
# Keep it stable. Changing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-generated-key

# --- Ticket log -------------------------------------------------------------
# LOG_BACKEND is sqlite or csv. LOG_PATH is a path inside the container;
# ./data on the host is mounted at /data.
# For CSV use LOG_BACKEND=csv and LOG_PATH=/data/uplink-log.csv.
LOG_BACKEND=sqlite
LOG_PATH=/data/uplink-log.sqlite

# --- Email intake -----------------------------------------------------------
# Where the email workflow posts tickets. Leave unset for the default,
# http://localhost:5678/webhook/ticket (inside the container).
# UPLINK_INTAKE_URL=
